#: src/Controllers/Auth/LoginController.php
msgid "Invalid security token"
msgstr "Mã bảo mật không hợp lệ"

#: src/Controllers/Auth/LoginController.php
msgid "Please enter both username and password"
msgstr "Vui lòng nhập cả tên đăng nhập và mật khẩu"

#: src/Controllers/Auth/RegisterController.php
msgid "Username is required"
msgstr "Tên đăng nhập là bắt buộc"

#: src/Controllers/Auth/RegisterController.php
msgid "Username must be at least 3 characters"
msgstr "Tên đăng nhập phải có ít nhất 3 ký tự"

#: src/Controllers/Auth/RegisterController.php
msgid "Username can only contain letters, numbers and underscores"
msgstr "Tên đăng nhập chỉ được chứa chữ cái, số và dấu gạch dưới"

#: src/Controllers/Auth/RegisterController.php
msgid "Username already exists"
msgstr "Tên đăng nhập đã tồn tại"

#: src/Controllers/Auth/RegisterController.php
msgid "Email is required"
msgstr "Email là bắt buộc"

#: src/Controllers/Auth/RegisterController.php
msgid "Invalid email address"
msgstr "Địa chỉ email không hợp lệ"

#: src/Controllers/Auth/RegisterController.php
msgid "Email already exists"
msgstr "Email đã tồn tại"

#: src/Controllers/Auth/RegisterController.php
msgid "Password is required"
msgstr "Mật khẩu là bắt buộc"

#: src/Controllers/Auth/RegisterController.php
msgid "Password must be at least 8 characters"
msgstr "Mật khẩu phải có ít nhất 8 ký tự"

#: src/Controllers/Auth/RegisterController.php
msgid "Password must contain letters and numbers"
msgstr "Mật khẩu phải chứa cả chữ cái và số"

#: src/Controllers/Auth/RegisterController.php
msgid "Please confirm your password"
msgstr "Vui lòng xác nhận mật khẩu"

#: src/Controllers/Auth/RegisterController.php
msgid "Passwords do not match"
msgstr "Mật khẩu không khớp"
