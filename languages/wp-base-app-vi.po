#: templates/pages/login.html.twig:28
msgid "Enter your credentials to access your account"
msgstr "Nhập thông tin đăng nhập để truy cập tài khoản"

#: templates/pages/login.html.twig:41
msgid "Username or Email"
msgstr "Tên đăng nhập hoặc Email"

#: templates/pages/login.html.twig:42
msgid "Enter your username or email"
msgstr "Nhập tên đăng nhập hoặc email"

#: templates/pages/login.html.twig:47
msgid "Password"
