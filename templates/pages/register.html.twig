{% extends 'layouts/base.html.twig' %}

{% block title %}Register -
	{{ get_bloginfo('name') }}
{% endblock %}

{% block content %}
	<div class="register-page">
		<div class="register-container" x-data="registerForm">
			<h1>Create an Account</h1>

			{# Server-side error from PHP #}
			{% if error %}
				<div class="error">{{ error|striptags }}</div>
			{% endif %}

			{% if success %}
				<div class="success">{{ success }}</div>
			{% endif %}

			<form method="POST" action="" @submit="submitForm($event)">
				<input type="hidden" name="register_nonce" value="{{ register_nonce }}">

				<div class="form-group">
					<label for="username">Username</label>
					<input type="text" id="username" name="username" x-model="form.username" @blur="validateField('username')" @focus="clearError('username')" :class="{ 'input-error': hasError('username') }" autofocus autocomplete="off">
					<span class="field-error" x-show="hasError('username')" x-text="errors.username"></span>
				</div>

				<div class="form-group">
					<label for="email">Email Address</label>
					<input type="text" id="email" name="email" x-model="form.email" @blur="validateField('email')" @focus="clearError('email')" :class="{ 'input-error': hasError('email') }" autocomplete="off">
					<span class="field-error" x-show="hasError('email')" x-text="errors.email"></span>
				</div>

				<div class="form-group">
					<label for="password">Password</label>
					<input type="password" id="password" name="password" x-model="form.password" @blur="validateField('password')" @focus="clearError('password')" :class="{ 'input-error': hasError('password') }" autocomplete="off">
					<span class="field-error" x-show="hasError('password')" x-text="errors.password"></span>
				</div>

				<div class="form-group">
					<label for="password_confirm">Confirm Password</label>
					<input type="password" id="password_confirm" name="password_confirm" x-model="form.password_confirm" @blur="validateField('password_confirm')" @focus="clearError('password_confirm')" :class="{ 'input-error': hasError('password_confirm') }" autocomplete="off">
					<span class="field-error" x-show="hasError('password_confirm')" x-text="errors.password_confirm"></span>
				</div>

				<button type="submit">Register</button>
			</form>

			<div class="links">
				<span>Already have an account?</span>
				<a href="{{ login_url }}">Login</a>
			</div>
		</div>
	</div>
{% endblock %}
