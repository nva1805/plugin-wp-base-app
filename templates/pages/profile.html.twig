{% extends 'layouts/base.html.twig' %}

{% block title %}
	{{ user.display_name }}
	- Profile
{% endblock %}

{% block content %}
	<div class="profile-page">
		<div
			class="profile-wrapper">
			<!-- Profile Header -->
			<div class="profile-header">
				<div class="profile-cover"></div>
				<div class="profile-info">
					<div class="profile-avatar">
						<img src="{{ user.avatar }}" alt="{{ user.display_name }}">
						{% if is_own_profile %}
							<button class="avatar-edit-btn" title="Change avatar">
								<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 015.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 00-1.134-.175 2.31 2.31 0 01-1.64-1.055l-.822-1.316a2.192 2.192 0 00-1.736-1.039 48.774 48.774 0 00-5.232 0 2.192 2.192 0 00-1.736 1.039l-.821 1.316z"/>
									<path stroke-linecap="round" stroke-linejoin="round" d="M16.5 12.75a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0zM18.75 10.5h.008v.008h-.008V10.5z"/>
								</svg>
							</button>
						{% endif %}
					</div>
					<div class="profile-details">
						<h1 class="profile-name">{{ user.display_name }}</h1>
						<p class="profile-username">@{{ user.username }}</p>
						{% if bio %}
							<p class="profile-bio">{{ bio }}</p>
						{% endif %}
					</div>
					{% if is_own_profile and can_edit %}
						<a href="{{ home_url('/profile/edit') }}" class="btn-edit-profile">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10"/>
							</svg>
							Edit Profile
						</a>
					{% endif %}
				</div>
			</div>

			<!-- Stats Cards -->
			<div class="profile-stats">
				<div class="stat-card">
					<div class="stat-icon">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/>
						</svg>
					</div>
					<div class="stat-content">
						<span class="stat-value">{{ stats.total_posts }}</span>
						<span class="stat-label">Posts</span>
					</div>
				</div>
				<div class="stat-card">
					<div class="stat-icon">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 01.865-.501 48.172 48.172 0 003.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z"/>
						</svg>
					</div>
					<div class="stat-content">
						<span class="stat-value">{{ stats.total_comments }}</span>
						<span class="stat-label">Comments</span>
					</div>
				</div>
				<div class="stat-card">
					<div class="stat-icon">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/>
						</svg>
					</div>
					<div class="stat-content">
						<span class="stat-value">{{ stats.member_since_days }}</span>
						<span class="stat-label">Days as Member</span>
					</div>
				</div>
			</div>

			<!-- Content Sections -->
			<div
				class="profile-content">
				<!-- Social Links -->
				{% if social_links.facebook or social_links.twitter or social_links.linkedin %}
					<div class="profile-section">
						<h2 class="section-title">Connect</h2>
						<div class="social-links">
							{% if social_links.facebook %}
								<a href="{{ social_links.facebook }}" class="social-link facebook" target="_blank" rel="noopener">
									<svg xmlns="http://www.w3.org/2000/svg" viewbox="0 0 24 24" fill="currentColor">
										<path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
									</svg>
								</a>
							{% endif %}
							{% if social_links.twitter %}
								<a href="{{ social_links.twitter }}" class="social-link twitter" target="_blank" rel="noopener">
									<svg xmlns="http://www.w3.org/2000/svg" viewbox="0 0 24 24" fill="currentColor">
										<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
									</svg>
								</a>
							{% endif %}
							{% if social_links.linkedin %}
								<a href="{{ social_links.linkedin }}" class="social-link linkedin" target="_blank" rel="noopener">
									<svg xmlns="http://www.w3.org/2000/svg" viewbox="0 0 24 24" fill="currentColor">
										<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
									</svg>
								</a>
							{% endif %}
						</div>
					</div>
				{% endif %}

				<!-- Recent Posts -->
				{% if posts|length > 0 %}
					<div class="profile-section">
						<h2 class="section-title">Recent Posts</h2>
						<div class="posts-list">
							{% for post in posts %}
								<a href="{{ post.permalink }}" class="post-item">
									<h3 class="post-title">{{ post.title }}</h3>
									<span class="post-date">{{ post.date|date('M d, Y') }}</span>
								</a>
							{% endfor %}
						</div>
					</div>
				{% endif %}

				<!-- Recent Comments -->
				{% if comments|length > 0 %}
					<div class="profile-section">
						<h2 class="section-title">Recent Comments</h2>
						<div class="comments-list">
							{% for comment in comments %}
								<div class="comment-item">
									<p class="comment-content">{{ comment.comment_content|striptags|slice(0, 150) }}
										{% if comment.comment_content|length > 150 %}...
										{% endif %}
									</p>
									<span class="comment-date">{{ comment.comment_date|date('M d, Y') }}</span>
								</div>
							{% endfor %}
						</div>
					</div>
				{% endif %}

				<!-- Account Info (only for own profile) -->
				{% if is_own_profile %}
					<div class="profile-section account-info">
						<h2 class="section-title">Account Information</h2>
						<div class="info-grid">
							<div class="info-item">
								<span class="info-label">Email</span>
								<span class="info-value">{{ user.email }}</span>
							</div>
							<div class="info-item">
								<span class="info-label">Member Since</span>
								<span class="info-value">{{ user.registered|date('F d, Y') }}</span>
							</div>
						</div>
					</div>
				{% endif %}
			</div>
		</div>
	</div>
{% endblock %}
